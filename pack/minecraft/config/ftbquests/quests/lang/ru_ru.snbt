	quest.67E4218FC3ACAA64.title: "Цинковый лист"
	quest.67E4218FC3ACAA64.quest_subtitle: "Для латунных конструкций"
	quest.67E4218FC3ACAA64.quest_desc: ["Цинковые листы нужны во многих рецептах."]
