	quest.7B8BB83EBB0EA4D3.title: "Коптильня"
	quest.7B8BB83EBB0EA4D3.quest_subtitle: "Улучшение контейнера"
	quest.7B8BB83EBB0EA4D3.quest_desc: ["Коптильня внутри ларца.", "Подробности в подсказке предмета."]
	quest.1868CE3FCDE75576.title: "Доменная печь"
	quest.1868CE3FCDE75576.quest_subtitle: "Улучшение контейнера"
	quest.1868CE3FCDE75576.quest_desc: ["Доменная печь внутри ларца.", "Подробности в подсказке предмета."]
	quest.4940D6CD3D6062EE.title: "Верстак"
	quest.4940D6CD3D6062EE.quest_subtitle: "Улучшение контейнера"
	quest.4940D6CD3D6062EE.quest_desc: ["Верстак прямо в ларце.", "Подробности в подсказке предмета."]
	quest.0020E435A1D4B586.title: "Стек I"
	quest.0020E435A1D4B586.quest_subtitle: "Улучшение контейнера"
	quest.0020E435A1D4B586.quest_desc: ["Увеличивает размер стека.", "Подробности в подсказке предмета."]
	quest.7A0B4C84392DC11B.title: "Стек II"
	quest.7A0B4C84392DC11B.quest_subtitle: "Улучшение контейнера"
	quest.7A0B4C84392DC11B.quest_desc: ["Увеличивает размер стека ещё больше.", "Подробности в подсказке предмета."]
	quest.7A0F9BA0757590B5.title: "Стек III"
	quest.7A0F9BA0757590B5.quest_subtitle: "Улучшение контейнера"
	quest.7A0F9BA0757590B5.quest_desc: ["Увеличивает размер стека ещё больше.", "Подробности в подсказке предмета."]
	quest.24A4A9333613C04E.title: "Контроллер склада"
	quest.24A4A9333613C04E.quest_subtitle: "Центр склада"
	quest.24A4A9333613C04E.quest_desc: ["Контроллер объединяет все контейнеры вокруг в единую систему."]
	quest.5D32E1D789B3A18F.title: "Соединитель"
	quest.5D32E1D789B3A18F.quest_subtitle: "Продлеваем сеть"
	quest.5D32E1D789B3A18F.quest_desc: ["Соединители расширяют сеть на расстояние."]
	task.3D65A0AF3CB7079D.title: "Соединить хранилища с контроллером"
	quest.2A1DBC5F4F4E86DE.title: "Связь"
	quest.2A1DBC5F4F4E86DE.quest_subtitle: "Связь с контроллером"
	quest.2A1DBC5F4F4E86DE.quest_desc: ["Связывает склад с контроллером."]
	quest.1735883FC2823513.title: "Порт ввода-вывода"
	quest.1735883FC2823513.quest_subtitle: "Вход и выход"
	quest.1735883FC2823513.quest_desc: ["Принимает и отдаёт предметы соседним механизмам."]
	quest.47139CEFFC320D60.title: "Порт ввода"
	quest.47139CEFFC320D60.quest_subtitle: "Только вход"
	quest.47139CEFFC320D60.quest_desc: ["Принимает предметы и больше ничего."]
	quest.583853C0E9F30486.title: "Порт вывода"
	quest.583853C0E9F30486.quest_subtitle: "Только выход"
	quest.583853C0E9F30486.quest_desc: ["Отдаёт предметы наружу."]
	quest.1412797BA81255D9.title: "Упаковочная лента"
	quest.1412797BA81255D9.quest_subtitle: "Для порядка и красоты"
	quest.1412797BA81255D9.quest_desc: ["Помогает переносить ларцы с содержимым."]
	quest.3069166522B8605B.title: "Кисть"
	quest.3069166522B8605B.quest_subtitle: "Для порядка и красоты"
	quest.3069166522B8605B.quest_desc: ["Красит ларцы и бочки."]
	quest.43A7260B3110DC64.title: "Стол декора"
	quest.43A7260B3110DC64.quest_subtitle: "Для порядка и красоты"
	quest.43A7260B3110DC64.quest_desc: ["Позволяет менять отделку ларцов."]
	quest.33E86003BB994298.title: "Инструмент склада"
	quest.33E86003BB994298.quest_subtitle: "Для порядка и красоты"
	quest.33E86003BB994298.quest_desc: ["Помогает настраивать склад."]
	quest.77669B3F5DF4D997.title: "Ограниченная бочка"
	quest.77669B3F5DF4D997.quest_subtitle: "Для порядка и красоты"
	quest.77669B3F5DF4D997.quest_desc: ["Хранит только часть слотов."]
	quest.43415E397D36B6A4.title: "Бочки всех уровней"
	quest.43415E397D36B6A4.quest_desc: ["Бочки работают как сундуки, но ставятся в любую сторону и могут нести рисунок из блоков.", "&6Как получить:&r верстак (улучшение хранилища): Бочка%s.", "&6Зачем нужен:&r идёт в Железная бочка%s."]
	quest.08B2AEB67800D798.title: "Шалкеровые ящики всех уровней"
	quest.08B2AEB67800D798.quest_desc: ["Улучшенные шалкеровые ящики сохраняют содержимое при разрушении — хранилище в кармане.", "&6Как получить:&r верстак (улучшение хранилища): Шалкеровый ящик.", "&6Зачем нужен:&r идёт в Железный шалкеровый ящик."]
	quest.0AB33E1057F991F3.title: "Ограниченные бочки"
	quest.0AB33E1057F991F3.quest_desc: ["Ограниченная бочка — аналог ящика Storage Drawers: хранит 1–4 вида предметов в больших количествах.", "&6Как получить:&r верстак: Рычаг, mangrove planks, mangrove slab.", "&6Зачем нужен:&r идёт в Ограниченная медная бочка%s II, Ограниченная железная бочка%s II.", "&7Вариантов: 7. Засчитывается «Ограниченная бочка%s II»."]
	task.021D215FCBAAF157.title: "Ограниченная бочка%s II (любой вариант)"
	quest.783E20FD55514D01.title: "Пошаговые расширения"
	quest.783E20FD55514D01.quest_desc: ["Расширение применяется ПКМ по уже стоящему хранилищу: оно повышает уровень, не вынимая вещей.", "&6Как получить:&r верстак: Рычаг.", "&6Зачем нужен:&r идёт в Расширение «Медь → Золото».", "&7Вариантов: 5. Засчитывается «Расширение «Медь → Железо»»."]
	task.56D3523250989A6F.title: "Расширение «Медь → Железо» (любой вариант)"
	quest.4D9DB0EC32D41400.title: "Автоплавка"
	quest.4D9DB0EC32D41400.quest_desc: ["&6Как работает:&r Обжарка предметов во вкладке улучшения", "Автоматически принимает и отдаёт предметы", "&6Как получить:&r верстак (следующий уровень): Воронка, Улучшение «Печь».", "&6Зачем нужен:&r идёт в Улучшение «Автопечь», Улучшение «Автоплавильня», Улучшение «Автокоптильня».", "&7Вариантов: 3. Засчитывается «Улучшение «Автопечь»»."]
	task.0F634F4C9E0AB8F9.title: "Улучшение «Автопечь» (любой вариант)"
	quest.67C839F83879FA11.title: "Улучшение «Уплотнение»"
	quest.67C839F83879FA11.quest_desc: ["&6Как работает:&r Автоматически сжимает и разжимает предметы", "&6Как получить:&r верстак: Поршень, Основа улучшения."]
	quest.44D1D605AF793462.title: "Улучшение «Камнерез»"
	quest.44D1D605AF793462.quest_desc: ["&6Как работает:&r Камнерез во вкладке улучшения", "&6Как получить:&r верстак: Камнерез, Основа улучшения.", "&6Зачем нужен:&r идёт в Улучшение «Камнерез»."]
	quest.718AE0C3868C24E5.title: "Улучшение «Проигрыватель»"
	quest.718AE0C3868C24E5.quest_desc: ["&6Как работает:&r Портативный проигрыватель", "&6Как получить:&r верстак: Проигрыватель, Основа улучшения.", "&6Зачем нужен:&r идёт в Улучшение «Проигрыватель», Продвинутое улучшение «Проигрыватель».", "&7Вариантов: 2. Засчитывается «Улучшение «Проигрыватель»»."]
	task.536525DA1EE7BDB6.title: "Улучшение «Проигрыватель» (любой вариант)"
	quest.3135E4383D507822.title: "Улучшение «Алхимия»"
	quest.3135E4383D507822.quest_desc: ["&6Как работает:&r Автоматически применяет зелья, еду с эффектами или вёдра молока", "&6Как получить:&r верстак: Огненный стержень, Жемчуг Края, fermented spider eye, Слеза гаста, Стеклянный пузырёк.", "&6Зачем нужен:&r идёт в Улучшение «Алхимия», Продвинутое улучшение «Алхимия»."]
	quest.5D77C88AFA9CE0E6.title: "Продвинутое улучшение «Подбор»"
	quest.5D77C88AFA9CE0E6.quest_desc: ["&6Как работает:&r Позволяет хранилищу подбирать предметы", "Имеет больше настроек фильтрации", "&6Как получить:&r верстак (следующий уровень): Улучшение «Подбор».", "&6Зачем нужен:&r идёт в Продвинутое улучшение «Подбор», Продвинутое улучшение «Магнит»."]
	quest.087B86A6952E7A5F.title: "Продвинутое улучшение «Магнит»"
	quest.087B86A6952E7A5F.quest_desc: ["&6Как работает:&r Притягивает предметы в хранилище на большем расстоянии", "Имеет больше настроек фильтрации", "&6Как получить:&r верстак (следующий уровень): Улучшение «Магнит».", "&6Зачем нужен:&r идёт в Продвинутое улучшение «Магнит»."]
	quest.23C12987AEA769D9.title: "Продвинутое улучшение «Фильтр»"
	quest.23C12987AEA769D9.quest_desc: ["&6Как работает:&r Фильтрует предметы, проходящие через хранилище при автоматизации", "Имеет больше настроек фильтрации", "&6Как получить:&r верстак (следующий уровень): Улучшение «Фильтр».", "&6Зачем нужен:&r идёт в Продвинутое улучшение «Фильтр»."]
	quest.1D18AE15028CDFB7.title: "Продвинутое улучшение «Пустота»"
	quest.1D18AE15028CDFB7.quest_desc: ["&6Как работает:&r Уничтожает попадающие в хранилище предметы согласно фильтру", "Имеет больше настроек фильтрации", "&6Как получить:&r верстак (следующий уровень): Улучшение «Пустота».", "&6Зачем нужен:&r идёт в Продвинутое улучшение «Пустота»."]
	quest.21A5352D6CE64609.title: "Продвинутое улучшение «Воронка»"
	quest.21A5352D6CE64609.quest_desc: ["&6Как работает:&r Принимает предметы из блока сверху и отдаёт их блоку снизу", "Работает быстрее и имеет больше настроек передачи", "&6Как получить:&r верстак (следующий уровень): Выбрасыватель, Улучшение «Воронка»."]
	quest.1E009926F094CA70.title: "Продвинутое улучшение «Кормление»"
	quest.1E009926F094CA70.quest_desc: ["&6Как работает:&r Кормит игрока едой из инвентаря хранилища", "Имеет больше настроек кормления", "&6Как получить:&r верстак (следующий уровень): Улучшение «Кормление».", "&6Зачем нужен:&r идёт в Продвинутое улучшение «Кормление»."]
	quest.44EA0BF7E24A15DD.title: "Продвинутое улучшение «Сжатие»"
	quest.44EA0BF7E24A15DD.quest_desc: ["&6Как работает:&r Упаковывает предметы в их сжатые варианты", "Поддерживает рецепты 2×2 и 3×3, а также имеет больше настроек фильтрации", "&6Как получить:&r верстак (следующий уровень): Улучшение «Сжатие».", "&6Зачем нужен:&r идёт в Продвинутое улучшение «Сжатие»."]
	quest.12261792A1C24BB9.title: "Продвинутое улучшение «Алхимия»"
	quest.12261792A1C24BB9.quest_desc: ["&6Как работает:&r Автоматически применяет зелья, еду с эффектами или вёдра молока", "Имеет дополнительные настройки фильтрации эффектов", "&6Как получить:&r верстак (следующий уровень): Улучшение «Алхимия».", "&6Зачем нужен:&r идёт в Продвинутое улучшение «Алхимия»."]
	quest.252BC42D47724167.title: "Переполнение IV–Ω"
	quest.252BC42D47724167.quest_desc: ["&6Как работает:&r Умножает количество стаков, помещаемых в слот, на 16", "&6Как получить:&r верстак: Улучшение «Переполнение III».", "&6Зачем нужен:&r идёт в Улучшение «Переполнение III», Улучшение «Переполнение V»."]
	quest.3273ECDA7846B625.title: "Улучшение «Переполнение I+»"
	quest.3273ECDA7846B625.quest_desc: ["&6Как работает:&r Умножает количество стаков, помещаемых в слот, на 3", "&6Как получить:&r верстак: Улучшение «Переполнение I».", "&6Зачем нужен:&r идёт в Улучшение «Переполнение 0», Улучшение «Переполнение II»."]
	quest.1CABA811DC45BD0D.title: "Понижение стака"
	quest.1CABA811DC45BD0D.quest_desc: ["&6Как работает:&r Делит количество стаков, помещаемых в слот, на 8", "&6Как получить:&r верстак: Кремень, Основа улучшения.", "&6Зачем нужен:&r идёт в Улучшение «Понижение I».", "&7Вариантов: 3. Засчитывается «Улучшение «Понижение I»»."]
	task.748DD382CFA13CE3.title: "Улучшение «Понижение I» (любой вариант)"
	quest.64124FCE212E2401.title: "Большая упаковочная лента"
	quest.64124FCE212E2401.quest_desc: ["&6Как получить:&r верстак: Упаковочная лента."]
	quest.71B95484AB869B1C.title: "Хранитель сокровищ"
	quest.71B95484AB869B1C.quest_subtitle: "Финал главы"
	quest.71B95484AB869B1C.quest_desc: ["Сундуки, бочки и улучшения — склад в идеальном порядке.", "&7Откроется, когда будут выполнены последние квесты главы. Отметьте галочку и заберите награду."]
	task.6884EF949AF82445.title: "Подвести итог главы"
	chapter.5FB42B457BB41714.title: "Единый склад"
	chapter.5FB42B457BB41714.chapter_subtitle: "Tom's Simple Storage — сеть хранилищ"
	quest.676166435848DE36.title: "Единый склад"
	quest.676166435848DE36.quest_subtitle: "Все сундуки в одном окне"
	quest.676166435848DE36.quest_desc: ["Tom's Storage соединяет ваши сундуки, бочки и ящики в одну сеть. Терминал показывает всё содержимое сразу и ищет по названию.", "Хорошо сочетается с хранилищами Sophisticated Storage и ящиками Storage Drawers."]
	task.2614B8EA81B41F5E.title: "Прочитать вступление"
	quest.4F1C3643C8B786C9.title: "Инвентарный коннектор"
	quest.4F1C3643C8B786C9.quest_desc: ["Коннектор — сердце сети: подключается к сундукам вокруг и к кабелям.", "&6Как получить:&r верстак: Сундук%s, Редстоуновый компаратор."]
	quest.0ECD548C5A697162.title: "Терминал хранилища"
	quest.0ECD548C5A697162.quest_desc: ["Терминал показывает все предметы сети. Ставится рядом с коннектором или через кабель.", "&6Как получить:&r верстак: Сундук%s, Обрамлённое стекло, Редстоуновый компаратор.", "&6Зачем нужен:&r идёт в Терминал крафта."]
	quest.1FAA3B69137A2EFA.title: "Соединитель инвентарей"
	quest.1FAA3B69137A2EFA.quest_desc: ["Соединитель инвентарей объединяет соседние хранилища в одно для коннектора.", "&6Как получить:&r верстак: Ведро воды, Соединитель инвентарей.", "&6Зачем нужен:&r идёт в Конфигуратор инвентаря."]
	quest.3714BF8A709B88DE.title: "Инвентарный кабель"
	quest.3714BF8A709B88DE.quest_desc: ["Кабель тянет сеть к дальним сундукам.", "&6Как получить:&r верстак: Сундук%s, Обрамлённый стеклянный люк.", "&6Зачем нужен:&r идёт в Базовая инвентарная воронка, Коннектор инвентарного кабеля, Инвентарный кабель в раме, Излучатель уровня."]
	quest.06E7D3265C4EF503.title: "Коннектор инвентарного кабеля"
	quest.06E7D3265C4EF503.quest_desc: ["&6Как получить:&r верстак: Сундук%s, Инвентарный кабель.", "&6Зачем нужен:&r идёт в Коннектор инвентарного кабеля в раме."]
	quest.2E1FF45A068AFC08.title: "Кабели в раме"
	quest.2E1FF45A068AFC08.quest_desc: ["&6Как получить:&r верстак: Инвентарный кабель.", "&7Вариантов: 2. Засчитывается «Инвентарный кабель в раме»."]
	task.20D9A61156788672.title: "Инвентарный кабель в раме (любой вариант)"
	quest.4CF501B6DEC08763.title: "Терминал крафта"
	quest.4CF501B6DEC08763.quest_desc: ["Терминал крафта: верстак прямо в окне склада, берёт материалы из сети.", "&6Как получить:&r верстак: Верстак, Терминал хранилища."]
	quest.359F5AE57B882A5A.title: "Беспроводной терминал"
	quest.359F5AE57B882A5A.quest_desc: ["Беспроводной терминал открывает склад издалека.", "&6Как получить:&r верстак: Обрамлённое стекло, Редстоуновый компаратор, Подзорная труба.", "&6Зачем нужен:&r идёт в Улучшенный беспроводной терминал."]
	quest.6435FF4399A64141.title: "Улучшенный беспроводной терминал"
	quest.6435FF4399A64141.quest_desc: ["&6Как получить:&r кузнечный стол: Незеритовый слиток, Кузнечный шаблон незеритового улучшения, Беспроводной терминал."]
	quest.11CFE55834F59E0B.title: "Фильтры"
	quest.11CFE55834F59E0B.quest_desc: ["&6Как получить:&r верстак.", "&6Зачем нужен:&r идёт в Полиморфный фильтр предметов, Фильтр по тегам.", "&7Вариантов: 3. Засчитывается «Фильтр предметов»."]
	task.0BD52CDFCD952D27.title: "Фильтр предметов (любой вариант)"
	quest.583EA06DB592B373.title: "Интерфейс и прокси"
	quest.583EA06DB592B373.quest_desc: ["Интерфейс позволяет воронкам и машинам класть вещи в сеть, прокси — видеть сеть как один сундук.", "&6Как получить:&r верстак: Сундук%s, Обрамлённый стеклянный люк."]
	quest.5F941643E4F7DBA1.title: "Базовая инвентарная воронка"
	quest.5F941643E4F7DBA1.quest_desc: ["&6Как получить:&r верстак: Воронка, Инвентарный кабель."]
	quest.3DFF6D8BC0B8024F.title: "Излучатель уровня"
