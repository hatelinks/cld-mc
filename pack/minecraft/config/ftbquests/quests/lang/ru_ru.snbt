	quest.5FBAC34739B018EA.title: "Урожаи дикой природы"
	quest.5FBAC34739B018EA.quest_subtitle: "Достижение"
	quest.5FBAC34739B018EA.quest_desc: ["&6Цель:&r Четыре новых культуры можно найти в дикой природе, в разных климатах... или где-нибудь в сундуках."]
	quest.618DBCFE7134119A.title: "Охота и собирательство"
	quest.618DBCFE7134119A.quest_subtitle: "Достижение"
	quest.618DBCFE7134119A.quest_desc: ["&6Цель:&r Создайте нож, чтобы добывать больше продуктов из растений и животных"]
	quest.6A0D817F695E18EC.title: "Берегите пальцы"
	quest.6A0D817F695E18EC.quest_subtitle: "Достижение"
	quest.6A0D817F695E18EC.quest_desc: ["&6Цель:&r Держа инструмент в руках, используйте его на разделочной доске, чтобы разделать некоторые предметы"]
	quest.21C8A8BC33E24FAD.title: "Хватаясь за соломинку"
	quest.21C8A8BC33E24FAD.quest_subtitle: "Достижение"
	quest.21C8A8BC33E24FAD.quest_desc: ["&6Цель:&r Срежьте траву ножом, чтобы получить солому"]
	quest.1F850205F79A4720.title: "Пускать корни"
	quest.1F850205F79A4720.quest_subtitle: "Достижение"
	quest.1F850205F79A4720.quest_desc: ["&6Цель:&r Посадите рис в неглубокий водоём"]
	quest.39D14D4566BCC63A.title: "Растительная пища"
	quest.39D14D4566BCC63A.quest_subtitle: "Достижение"
	quest.39D14D4566BCC63A.quest_desc: ["&6Цель:&r Оставьте немного органического компоста разлагаться, пока он не превратится в плодородную почву. Грибы могут помочь!"]
	quest.340A29C9B6759E3E.title: "Продвинутое компостирование"
	quest.340A29C9B6759E3E.quest_subtitle: "Достижение"
	quest.340A29C9B6759E3E.quest_desc: ["&6Цель:&r Разместите органический компост. Он разлагается лучше с солнцем, водой и грибами!"]
	quest.19384F0A0FFD7E88.title: "Грибы среди нас"
	quest.19384F0A0FFD7E88.quest_subtitle: "Достижение"
	quest.19384F0A0FFD7E88.quest_desc: ["&6Цель:&r Посадите грибы в тёмное место, дождитесь образования колонии, а затем срежьте её!"]
	quest.254863B9915AFEB9.title: "Шпалера"
	quest.254863B9915AFEB9.quest_subtitle: "Достижение"
	quest.254863B9915AFEB9.quest_desc: ["&6Цель:&r Повесьте верёвку над томатной лозой, чтобы она росла выше"]
	quest.405C32D74D97CD3C.title: "Кушать подано!"
	quest.405C32D74D97CD3C.quest_subtitle: "Достижение"
	quest.405C32D74D97CD3C.quest_desc: ["&6Цель:&r Поставьте кухонный котёл и приступайте за готовку!"]
	quest.4B16BEA05407074E.title: "Осторожно, горячо!"
	quest.4B16BEA05407074E.quest_subtitle: "Достижение"
	quest.4B16BEA05407074E.quest_desc: ["&6Цель:&r Поставьте свою сковороду на блок крадучись"]
	quest.78266B3420B76462.title: "Готовка на ходу"
	quest.78266B3420B76462.quest_subtitle: "Достижение"
	quest.78266B3420B76462.quest_desc: ["&6Цель:&r Сковороды позволяют готовить на ходу. Встаньте возле огня, и держите еду в другой руке!"]
	quest.25CC1C7D803AF2D9.title: "Вкусно и питательно"
	quest.25CC1C7D803AF2D9.quest_subtitle: "Достижение"
	quest.25CC1C7D803AF2D9.quest_desc: ["&6Цель:&r Сытное блюдо подарит вам сытость на длительное время!"]
	quest.3D11FB6C6590E9ED.title: "Пир на весь мир"
	quest.3D11FB6C6590E9ED.quest_subtitle: "Достижение"
	quest.3D11FB6C6590E9ED.quest_desc: ["&6Цель:&r Некоторые блюда лучше всего подавать на стол, чтобы разделить их с друзьями. Приготовьте свои миски!"]
	quest.00F10018752AD118.title: "Дикий мясник"
	quest.00F10018752AD118.quest_subtitle: "Достижение"
	quest.00F10018752AD118.quest_desc: ["&6Цель:&r Используйте нож для извлечения больших кусков мяса из Свиней"]
	quest.40F87620E428BDEF.title: "Фуу! Позор!"
	quest.40F87620E428BDEF.quest_subtitle: "Достижение"
	quest.40F87620E428BDEF.quest_desc: ["&6Цель:&r Бросьте гнилой томат в надоедливого разбойника!"]
	quest.7F3B873C15D2A584.title: "Севооборот"
	quest.7F3B873C15D2A584.quest_subtitle: "Достижение"
	quest.7F3B873C15D2A584.quest_desc: ["&6Цель:&r Вырастите все фрукты, овощи, грибы и корни, какие только сможете найти!"]
	quest.52A600982EA7E6B5.title: "Не выносишь жару..."
	quest.52A600982EA7E6B5.quest_subtitle: "Достижение"
	quest.52A600982EA7E6B5.quest_desc: ["&6Цель:&r Потратьте целый незеритовый слиток, чтобы улучшить свой нож! Или свалите с кухни."]
	quest.7BE65D4B05947D0C.title: "Шеф-повар"
	quest.7BE65D4B05947D0C.quest_subtitle: "Достижение"
	quest.7BE65D4B05947D0C.quest_desc: ["&6Цель:&r Попробуйте все доступные виды блюд!"]
	quest.5675E6F682BAA16C.title: "Салатус начнём!"
	quest.5675E6F682BAA16C.quest_subtitle: "Достижение"
	quest.5675E6F682BAA16C.quest_desc: ["&6Цель:&r Соберите свой первый овощ"]
	quest.0110352113E8AE65.title: "Разве это не фрукт?"
	quest.0110352113E8AE65.quest_subtitle: "Достижение"
	quest.0110352113E8AE65.quest_desc: ["&6Цель:&r Среди нас амогус"]
