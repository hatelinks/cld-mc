	quest.5B9E87BA9DDEE425.title: "Хранитель знаний"
	quest.5B9E87BA9DDEE425.quest_subtitle: "Финал главы"
	quest.5B9E87BA9DDEE425.quest_desc: ["Опыт течёт по трубам, а чары накладываются автоматически.", "&7Откроется, когда будут выполнены последние квесты главы. Отметьте галочку и заберите награду."]
	task.7D4094C659ADBD68.title: "Подвести итог главы"
