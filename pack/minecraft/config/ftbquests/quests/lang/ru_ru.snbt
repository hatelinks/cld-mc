	quest.106C96647FB416C4.quest_subtitle: "Достижение"
	quest.106C96647FB416C4.quest_desc: ["&6Цель:&r Make every dish possible out of sweet potatoes"]
	quest.2C8EAF78F7D564FE.title: "Репа-ритм"
	quest.2C8EAF78F7D564FE.quest_subtitle: "Достижение"
	quest.2C8EAF78F7D564FE.quest_desc: ["&6Цель:&r Приготовьте все блюда из репы"]
