	quest.3DFCF9188D4DD469.quest_desc: ["&6Как получить:&r верстак: Бирка, Ключ от ящика.", "&6Зачем нужен:&r идёт в Персональный ключ (CoFH)."]
	quest.75E41F0951C0441D.title: "Кнопки-ключи"
	quest.75E41F0951C0441D.quest_desc: ["&6Как получить:&r верстак: Каменная кнопка, Ключ от ящика.", "&7Вариантов: 3. Засчитывается «Кнопка ключа ящика»."]
