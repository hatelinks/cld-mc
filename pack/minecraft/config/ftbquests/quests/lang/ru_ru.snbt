	quest.7C02CC7383DAD00E.quest_desc: ["&6Как получить:&r верстак: Жемчуг Края, Шаблон для улучшений.", "&6Зачем нужен:&r идёт в Улучшение \"Удалённый доступ (Группа)\"."]
