	quest.3B8770791EC36103.quest_subtitle: "Достижение"
	quest.3B8770791EC36103.quest_desc: ["&6Цель:&r Make every dish possible out of cauliflowers"]
	quest.2C54B8BF11E782B7.title: "Поймай их всех!"
	quest.2C54B8BF11E782B7.quest_subtitle: "Достижение"
	quest.2C54B8BF11E782B7.quest_desc: ["&6Цель:&r Соберите все овощи"]
	quest.30EF7E4D98F7FAB9.title: "Большой урожай"
	quest.30EF7E4D98F7FAB9.quest_desc: ["Соберите большой урожай — по 64 пшеницы, моркови и картофеля. Механический комбайн Create очень поможет."]
	quest.2553D1D968B0B910.title: "Щедрый урожай"
	quest.2553D1D968B0B910.quest_subtitle: "Финал главы"
	quest.2553D1D968B0B910.quest_desc: ["Ваша ферма и кухня работают в полную силу.", "&7Откроется, когда будут выполнены последние квесты главы. Отметьте галочку и заберите награду."]
	task.37D8DBCEA663C903.title: "Подвести итог главы"
	chapter_group.16043205C9B2450B.title: "Мистическое земледелие"
	chapter.6C80E321C359DC86.title: "Семена бытия"
	chapter.6C80E321C359DC86.chapter_subtitle: "Mystical Agriculture — выращивайте ресурсы из эссенций"
	quest.53EBCDA4BFDB493B.title: "Мистический сад"
	quest.53EBCDA4BFDB493B.quest_subtitle: "Выращиваем руду на грядках"
	quest.53EBCDA4BFDB493B.quest_desc: ["Mystical Agriculture позволяет выращивать ресурсы как обычные культуры.", "Из руд и мобов добываются эссенции, из них делаются семена, а семена растут на специальной земле."]
	task.43F0D181659E415E.title: "Открыть книгу Mystical Agriculture"
	quest.0D5F1E70FF50C70F.title: "Руда инфериума"
	quest.0D5F1E70FF50C70F.quest_subtitle: "Источник эссенции"
	quest.0D5F1E70FF50C70F.quest_desc: ["Руда встречается под землёй в обычном мире.", "Из неё выпадает инфериумовая эссенция."]
	quest.549472105094A59C.title: "Эссенция инфериума"
	quest.549472105094A59C.quest_subtitle: "Основа всего"
	quest.549472105094A59C.quest_desc: ["Эссенция нужна для семян и многих рецептов."]
	quest.16B060CC2C9A0511.title: "Осколок процветания"
	quest.16B060CC2C9A0511.quest_subtitle: "Руда процветания"
	quest.16B060CC2C9A0511.quest_desc: ["Осколки выпадают из руды процветания и нужны для крафта."]
	quest.67AAAF03F00EBB4A.title: "Руда процветания"
	quest.67AAAF03F00EBB4A.quest_subtitle: "Откуда осколки"
	quest.67AAAF03F00EBB4A.quest_desc: ["Руда встречается под землёй, глубже может быть глубинный вариант."]
	quest.2B3DFC18A20346FE.title: "Слиток процветания"
	quest.2B3DFC18A20346FE.quest_subtitle: "Металл знания"
	quest.2B3DFC18A20346FE.quest_desc: ["Слитки нужны для многих деталей мода."]
	quest.63108DCABED29F5B.title: "База семян"
	quest.63108DCABED29F5B.quest_subtitle: "Основа любого семени"
	quest.63108DCABED29F5B.quest_desc: ["Из базы семян делаются семена под любую культуру."]
	quest.42365F13D1C49077.title: "Первые семена"
	quest.42365F13D1C49077.quest_subtitle: "Начало посадок"
	quest.42365F13D1C49077.quest_desc: ["Инфериум — самая простая культура, на ней учатся основам мода."]
	quest.6F761A87AC472585.title: "Земля инфериума"
	quest.6F761A87AC472585.quest_subtitle: "Особая грядка"
	quest.6F761A87AC472585.quest_desc: ["Мистические культуры растут только на специальной земле соответствующего уровня."]
	quest.1CA0E40DB0649CFA.title: "Мистическое удобрение"
	quest.1CA0E40DB0649CFA.quest_subtitle: "Мгновенный рост"
	quest.1CA0E40DB0649CFA.quest_desc: ["Мгновенно завершает рост мистической культуры."]
	quest.6DA47918EC82621E.title: "Земляной урожай"
	quest.6DA47918EC82621E.quest_subtitle: "Первая культура"
	quest.6DA47918EC82621E.quest_desc: ["Вырастите ресурсные семена и соберите урожай эссенции."]
	quest.5DE024BF50C04C7A.title: "Каменный урожай"
	quest.5DE024BF50C04C7A.quest_subtitle: "Камень на грядке"
	quest.5DE024BF50C04C7A.quest_desc: ["Грядка с камнем избавит от лишней добычи."]
	quest.05B42D32872500AE.title: "Древесный урожай"
	quest.05B42D32872500AE.quest_subtitle: "Лес без леса"
	quest.05B42D32872500AE.quest_desc: ["Эссенция превращается в брёвна и другие деревянные материалы."]
	quest.29ECC4EF31E487FF.title: "Угольный урожай"
	quest.29ECC4EF31E487FF.quest_subtitle: "Топливо"
	quest.29ECC4EF31E487FF.quest_desc: ["Бесконечное топливо для печей и горелок."]
	quest.10AE93D6BC56C3B9.title: "Медный урожай"
	quest.10AE93D6BC56C3B9.quest_subtitle: "Медь на грядке"
	quest.10AE93D6BC56C3B9.quest_desc: ["Медь нужна для Create и многих рецептов."]
	quest.7A786547F86A05BC.title: "Железный урожай"
	quest.7A786547F86A05BC.quest_subtitle: "Металл на грядке"
	quest.7A786547F86A05BC.quest_desc: ["Железо без походов в шахту."]
	quest.4F303FD0C297BD92.title: "Красный урожай"
	quest.4F303FD0C297BD92.quest_subtitle: "Редстоун без шахты"
	quest.4F303FD0C297BD92.quest_desc: ["Пригодится для автоматизации."]
	quest.5EE6533FDEA96192.title: "Золотой урожай"
	quest.5EE6533FDEA96192.quest_subtitle: "Золото на грядке"
	quest.5EE6533FDEA96192.quest_desc: ["Золото нужно для листов и многих рецептов."]
	quest.2AADCFFCB5A59087.title: "Алмазный урожай"
	quest.2AADCFFCB5A59087.quest_subtitle: "Алмазы на грядке"
	quest.2AADCFFCB5A59087.quest_desc: ["Для высоких уровней ферм потребуются продвинутые грядки."]
	quest.0D950F0558271BA7.title: "Изумрудный урожай"
	quest.0D950F0558271BA7.quest_subtitle: "Изумруд на грядке"
	quest.0D950F0558271BA7.quest_desc: ["Выгоден для торговли с жителями."]
	quest.2F144FF1B54793A7.title: "Воздух"
	quest.2F144FF1B54793A7.quest_subtitle: "Стихия ветра"
	quest.2F144FF1B54793A7.quest_desc: ["Нужна для рецептов агломератов."]
	quest.2D23BFE225A3C5F4.title: "Земля"
	quest.2D23BFE225A3C5F4.quest_subtitle: "Стихия земли"
	quest.2D23BFE225A3C5F4.quest_desc: ["Нужна для рецептов агломератов."]
	quest.34CCA1F0A3DB330D.title: "Вода"
	quest.34CCA1F0A3DB330D.quest_subtitle: "Стихия воды"
	quest.34CCA1F0A3DB330D.quest_desc: ["Нужна для рецептов агломератов."]
	quest.45F04018E0FA8C4F.title: "Огонь"
	quest.45F04018E0FA8C4F.quest_subtitle: "Стихия огня"
	quest.45F04018E0FA8C4F.quest_desc: ["Нужна для рецептов агломератов."]
	quest.7D9C8A0362F5AADD.title: "Зомби на грядке"
	quest.7D9C8A0362F5AADD.quest_subtitle: "Мясо и гниль"
	quest.7D9C8A0362F5AADD.quest_desc: ["Падаль растёт на грядке, а не бегает по ночам."]
	quest.452DFBB61F6C9044.title: "Коровий урожай"
	quest.452DFBB61F6C9044.quest_subtitle: "Кожа и мясо"
	quest.452DFBB61F6C9044.quest_desc: ["Ресурсы коровы без скотного двора."]
	quest.7005211D8CB126CB.title: "Огненный урожай"
	quest.7005211D8CB126CB.quest_subtitle: "Стержни без Нижнего мира"
	quest.7005211D8CB126CB.quest_desc: ["Ифриты на грядке: стержни для зелий и горелок Create."]
	quest.3C1DBE2D71FEE0D6.title: "Эссенция пруденция"
	quest.3C1DBE2D71FEE0D6.quest_subtitle: "Второй уровень"
	quest.3C1DBE2D71FEE0D6.quest_desc: ["Эссенции высших уровней дают более продвинутые культуры, смотрите JEI."]
	quest.6F8AD82D0D28B68B.title: "Эссенция терциума"
	quest.6F8AD82D0D28B68B.quest_subtitle: "Третий уровень"
	quest.6F8AD82D0D28B68B.quest_desc: ["Ещё более ценная эссенция."]
	quest.3A24838EF6D12015.title: "Эссенция империума"
	quest.3A24838EF6D12015.quest_subtitle: "Четвёртый уровень"
	quest.3A24838EF6D12015.quest_desc: ["Эссенции этого уровня нужны для сильной экипировки."]
	quest.20A4C0B01C02F7EC.title: "Эссенция супремиума"
	quest.20A4C0B01C02F7EC.quest_subtitle: "Пятый уровень"
	quest.20A4C0B01C02F7EC.quest_desc: ["Предел обычных эссенций, дальше идёт пробуждение."]
	quest.476AD4588E80FA92.title: "Агломератио"
	quest.476AD4588E80FA92.quest_subtitle: "Стихии в концентрате"
	quest.476AD4588E80FA92.quest_desc: ["Агломератио нужны для культур, зависящих от стихий.", "Рецепты смотрите в JEI."]
	quest.537CE6B6E9431103.title: "Лейка"
	quest.537CE6B6E9431103.quest_desc: ["Простая лейка без ступени: поливает небольшую область и ускоряет рост.", "&6Как получить:&r верстак: Костная мука, Миска.", "&6Зачем нужен:&r идёт в Инфериевая лейка."]
	quest.214F422847FE9B3F.title: "Алмазный серп и коса"
	quest.214F422847FE9B3F.quest_desc: ["&6Как получить:&r верстак.", "&6Зачем нужен:&r идёт в Инфериевый серп."]
	quest.7703BFBD3B2DB563.title: "Все сгустки"
	quest.7703BFBD3B2DB563.quest_desc: ["Сгустки — сжатые эссенции. Из них делаются семена сложных ресурсов.", "&6Как получить:&r верстак: Комок глины, Земля, Стеклянный пузырёк, Гравий.", "&7Вариантов: 11. Засчитывается «Сгусток воздуха»."]
	task.3707809FD47538D5.title: "Сгусток воздуха (любой вариант)"
	quest.47032A5DD087C003.title: "Капли и капсулы опыта"
	quest.47032A5DD087C003.quest_desc: ["&6Как получить:&r верстак: Experience essence.", "&6Зачем нужен:&r идёт в Жидкий опыт, Пузырёк опыта."]
	quest.08C8F9C198DB1B31.title: "Пыль душ"
	quest.08C8F9C198DB1B31.quest_desc: ["&6Как получить:&r печь: Гладкий камень душ.", "&6Зачем нужен:&r идёт в Пустой череп, Стекло душ."]
	quest.377DA253946DEF04.title: "Пустые заготовки"
	quest.377DA253946DEF04.quest_desc: ["&6Как получить:&r верстак: bone block, Пыль душ.", "&6Зачем нужен:&r идёт в Череп скелета-иссушителя."]
	quest.73F849A477A748D2.title: "Не настроенное расширение"
	quest.73F849A477A748D2.quest_desc: ["Основа для расширений инструментов и брони Mystical Agriculture.", "&6Как получить:&r верстак: Осколок процветания."]
	quest.6EDF702A7CD3237D.title: "Визеростойкий блок"
	quest.6EDF702A7CD3237D.quest_desc: ["&6Как получить:&r верстак: Камень душ, Wither skeleton essence.", "&6Зачем нужен:&r идёт в Визеростойкие кирпичи."]
	quest.11A7454ADEAABAD7.title: "Блоки эссенций"
	quest.11A7454ADEAABAD7.quest_desc: ["&6Как получить:&r верстак: Инфериевая эссенция.", "&6Зачем нужен:&r идёт в Инфериевая эссенция, Прудентиевый блок.", "&7Вариантов: 6. Засчитывается «Инфериевый блок»."]
	task.0ED741D122D44BF4.title: "Инфериевый блок (любой вариант)"
	quest.34D465DA21CD1005.title: "Кусочки металлов"
	quest.34D465DA21CD1005.quest_desc: ["&6Как получить:&r верстак: Инфериевый слиток.", "&6Зачем нужен:&r идёт в Инфериевый слиток.", "&7Вариантов: 8. Засчитывается «Кусочек инферия»."]
	task.679A559F5F42E6AF.title: "Кусочек инферия (любой вариант)"
	quest.750DA435276DE534.title: "Блоки слитков"
	quest.750DA435276DE534.quest_desc: ["&6Как получить:&r верстак: Инфериевый слиток.", "&6Зачем нужен:&r идёт в Инфериевый слиток.", "&7Вариантов: 6. Засчитывается «Блок инфериевых слитков»."]
	task.2DF588786F04544F.title: "Блок инфериевых слитков (любой вариант)"
	quest.542FF3FD5B2AE5C8.title: "Мистический садовник"
	quest.542FF3FD5B2AE5C8.quest_subtitle: "Финал главы"
	quest.542FF3FD5B2AE5C8.quest_desc: ["Ресурсы растут на ваших грядках.", "&7Откроется, когда будут выполнены последние квесты главы. Отметьте галочку и заберите награду."]
	task.44706C3D6A0FB794.title: "Подвести итог главы"
	chapter.3E5F2AD5B76AB93E.title: "Алтари и души"
	chapter.3E5F2AD5B76AB93E.chapter_subtitle: "Mystical Agriculture — инфузия, пробуждение и автоматизация"
	quest.33DFC8922EAF47A3.title: "Пьедестал инфузии"
	quest.33DFC8922EAF47A3.quest_subtitle: "Подставки для ингредиентов"
	quest.33DFC8922EAF47A3.quest_desc: ["Вокруг алтаря ставятся пьедесталы, на них кладут ингредиенты рецептов."]
	quest.61B65A3ED7BE3828.title: "Алтарь инфузии"
	quest.61B65A3ED7BE3828.quest_subtitle: "Создание семян"
	quest.61B65A3ED7BE3828.quest_desc: ["На алтаре инфузии из базы семян и эссенций делаются семена для культур."]
	quest.535437FB70D9C21A.title: "Кристалл инфузии"
	quest.535437FB70D9C21A.quest_subtitle: "Катализатор"
	quest.535437FB70D9C21A.quest_desc: ["Кристалл нужен для создания семян и других рецептов."]
	quest.229B35E02987370D.title: "Первая инфузия"
	quest.229B35E02987370D.quest_subtitle: "Обряд"
	quest.229B35E02987370D.quest_desc: ["Положите базу семян на алтарь, а нужные ингредиенты расставьте на пьедесталах."]
	task.5401634E4012CCD9.title: "Создать семена на алтаре инфузии"
	quest.3107890C30964912.title: "Сосуд эссенции"
	quest.3107890C30964912.quest_subtitle: "Хранилище эссенций"
	quest.3107890C30964912.quest_desc: ["В сосуде удобно держать эссенции для инфузии."]
	quest.16AD72970226FA13.title: "Мастер-кристалл"
	quest.16AD72970226FA13.quest_subtitle: "Высший катализатор"
	quest.16AD72970226FA13.quest_desc: ["Нужен для ритуалов высшего уровня."]
	quest.4E8E0A874B2E61A0.title: "Пьедестал пробуждения"
	quest.4E8E0A874B2E61A0.quest_subtitle: "Подставки для пробуждения"
	quest.4E8E0A874B2E61A0.quest_desc: ["Пьедесталы окружают алтарь пробуждения."]
	quest.149B20CA99873848.title: "Алтарь пробуждения"
	quest.149B20CA99873848.quest_subtitle: "Высший ритуал"
	quest.149B20CA99873848.quest_desc: ["Здесь создаются самые мощные материалы мода."]
	quest.2CC6F6B609EE5C4A.title: "Пробуждённый супремиум"
	quest.2CC6F6B609EE5C4A.quest_subtitle: "Вершина материалов"
	quest.2CC6F6B609EE5C4A.quest_desc: ["Самый ценный материал мода."]
	quest.43CAA4006D98B561.title: "Стол изменений"
	quest.43CAA4006D98B561.quest_subtitle: "Улучшаем снаряжение"
	quest.43CAA4006D98B561.quest_desc: ["На столе улучшения вставляют усилители в инструменты и броню."]
	quest.2BFD9BCEFCB78E17.title: "Зачарователь"
	quest.2BFD9BCEFCB78E17.quest_subtitle: "Особые чары"
	quest.2BFD9BCEFCB78E17.quest_desc: ["Мистический зачарователь работает с эссенциями."]
	quest.4EE3355D1ECCE020.title: "Каркас станка"
	quest.4EE3355D1ECCE020.quest_subtitle: "Основа автоматизации"
	quest.4EE3355D1ECCE020.quest_desc: ["Из каркаса делаются все станки мода."]
	quest.14D605F3D882C7CF.title: "Мистическая печь"
	quest.14D605F3D882C7CF.quest_subtitle: "Печь для эссенций"
	quest.14D605F3D882C7CF.quest_desc: ["Быстрая печь мода, работает на мистическом топливе."]
	quest.2DF0163A30459511.title: "Переработчик семян"
	quest.2DF0163A30459511.quest_subtitle: "Семена в семена"
	quest.2DF0163A30459511.quest_desc: ["Переделывает ненужные семена в нужные."]
	quest.0AC635586848D766.title: "Автокомбайн"
	quest.0AC635586848D766.quest_subtitle: "Сбор без рук"
	quest.0AC635586848D766.quest_desc: ["Автоматически собирает урожай с грядок в радиусе."]
	quest.5FB6CBBA78AFFED8.title: "База улучшений"
	quest.5FB6CBBA78AFFED8.quest_subtitle: "Усиление станков"
	quest.5FB6CBBA78AFFED8.quest_desc: ["Улучшения повышают скорость и эффективность станков."]
	quest.3DAFEC3CBAD3B2B6.title: "Камень душ"
	quest.3DAFEC3CBAD3B2B6.quest_subtitle: "Особый камень"
	quest.3DAFEC3CBAD3B2B6.quest_desc: ["Камень душ встречается в мире или делается в рецептах."]
	quest.303E7117B0752EE2.title: "Стекло душ"
	quest.303E7117B0752EE2.quest_subtitle: "Особое стекло"
	quest.303E7117B0752EE2.quest_desc: ["Нужно для сосудов и станков."]
	quest.6706F4068E7D73AC.title: "Руда душ"
	quest.6706F4068E7D73AC.quest_subtitle: "Источник пыли душ"
	quest.6706F4068E7D73AC.quest_desc: ["Руда встречается под землёй, из неё выпадает пыль душ."]
	quest.39F62F97C2AD45AA.title: "Слиток душ"
	quest.39F62F97C2AD45AA.quest_subtitle: "Металл душ"
	quest.39F62F97C2AD45AA.quest_desc: ["Слиток нужен для оружия и спавнера."]
	quest.347E71C0738E6803.title: "Кинжал душ"
	quest.347E71C0738E6803.quest_subtitle: "Собираем души"
	quest.347E71C0738E6803.quest_desc: ["Убийства кинжалом пополняют сосуд для душ."]
	quest.6DE6533D488F4B2D.title: "Сосуд для душ"
	quest.6DE6533D488F4B2D.quest_subtitle: "Хранилище душ"
	quest.6DE6533D488F4B2D.quest_desc: ["Хранит накопленные души для спавнера."]
	quest.100ACF9639AA4835.title: "Экстрактор душ"
	quest.100ACF9639AA4835.quest_subtitle: "Души из предметов"
	quest.100ACF9639AA4835.quest_desc: ["Достаёт души из предметов, которые когда-то были мобами."]
	quest.55E7641A79D71058.title: "Спавнер душ"
	quest.55E7641A79D71058.quest_subtitle: "Моб-ферма в блоке"
	quest.55E7641A79D71058.quest_desc: ["Порождает мобов с помощью накопленных душ.", "Подробности смотрите в книге мода."]
	quest.23D4822A27E18FDA.title: "Хранитель алтарей"
	quest.23D4822A27E18FDA.quest_subtitle: "Финал главы"
	quest.23D4822A27E18FDA.quest_desc: ["Инфузия, пробуждение и души подчинены вам.", "&7Откроется, когда будут выполнены последние квесты главы. Отметьте галочку и заберите награду."]
	task.78B44BEDA2279E01.title: "Подвести итог главы"
	chapter.0F0164300AC460D0.title: "Ступени мастерства"
	chapter.0F0164300AC460D0.chapter_subtitle: "Mystical Agriculture — снаряжение всех ступеней"
	quest.02CCBA76EA1DEEED.title: "Инфериум: материалы"
	quest.02CCBA76EA1DEEED.quest_subtitle: "Слитки и самоцветы"
	quest.02CCBA76EA1DEEED.quest_desc: ["&6Как работает:&r слиток и самоцвет — основные материалы ступени, из них делают инструменты, броню и блоки.", "&6Зачем нужен:&r без них не создать ни одну вещь этой ступени.", "&6Как использовать:&r получаются на алтаре инфузии из материалов предыдущей ступени и эссенции."]
	quest.1D29A4860F9A950F.title: "Инфериум: грядки"
	quest.1D29A4860F9A950F.quest_subtitle: "Земля и ускорители роста"
	quest.1D29A4860F9A950F.quest_desc: ["&6Как работает:&r особая земля ускоряет рост семян, а ускоритель сокращает время созревания рядом стоящих культур.", "&6Зачем нужен:&r чем выше ступень, тем быстрее и выгоднее урожай.", "&6Как использовать:&r посадите семена на землю нужной ступени и поставьте ускоритель рядом."]
	quest.22E756CCBABDEF2C.title: "Инфериум: улучшения"
	quest.22E756CCBABDEF2C.quest_subtitle: "Улучшение для машин"
	quest.22E756CCBABDEF2C.quest_desc: ["&6Как работает:&r улучшение вставляется в машины Mystical Agriculture и повышает их скорость.", "&6Зачем нужен:&r ускоряет автоматизацию.", "&6Как использовать:&r поместите в слот улучшений на машине."]
	quest.51CC73277F8DF424.title: "Инфериум: лейка"
	quest.51CC73277F8DF424.quest_subtitle: "Лейка нужной ступени"
	quest.51CC73277F8DF424.quest_desc: ["&6Как работает:&r лейка поливает область вокруг и ускоряет рост культур.", "&6Зачем нужен:&r полезна пока автоматизации ещё нет.", "&6Как использовать:&r зажмите ПКМ рядом с грядками."]
	quest.1D88817EB477F912.title: "Инфериум: жатва"
	quest.1D88817EB477F912.quest_subtitle: "Серп и коса"
	quest.1D88817EB477F912.quest_desc: ["&6Как работает:&r серп собирает урожай по области, коса — по ещё большей.", "&6Зачем нужен:&r быстрый ручной сбор.", "&6Как использовать:&r ЛКМ по зрелой культуре."]
	quest.3465585651452E50.title: "Инфериум: инструменты"
	quest.3465585651452E50.quest_subtitle: "Меч, кирка, топор, лопата, мотыга"
	quest.3465585651452E50.quest_desc: ["&6Как работает:&r полный набор инструментов ступени.", "&6Зачем нужен:&r прочнее и эффективнее предыдущих.", "&6Как использовать:&r собираются из слитков ступени на верстаке."]
	quest.7377D4F1AF19B918.title: "Инфериум: снаряжение"
	quest.7377D4F1AF19B918.quest_subtitle: "Лук, арбалет, удочка, ножницы"
	quest.7377D4F1AF19B918.quest_desc: ["&6Как работает:&r дальнобойное и вспомогательное снаряжение ступени.", "&6Зачем нужен:&r закрывает все виды деятельности.", "&6Как использовать:&r как обычные аналоги."]
	quest.2192574C5C2DB5DF.title: "Инфериум: броня"
	quest.2192574C5C2DB5DF.quest_subtitle: "Полный комплект"
	quest.2192574C5C2DB5DF.quest_desc: ["&6Как работает:&r четыре части брони дают защиту выше предыдущей ступени.", "&6Зачем нужен:&r полный комплект — надёжная защита.", "&6Как использовать:&r соберите все четыре части."]
	quest.2611704F1AFFB684.title: "Инфериум: посох"
	quest.2611704F1AFFB684.quest_subtitle: "Посох ступени"
	quest.2611704F1AFFB684.quest_desc: ["&6Как работает:&r магический посох ступени.", "&6Зачем нужен:&r особое оружие/инструмент мода.", "&6Как использовать:&r ПКМ в нужном режиме."]
	quest.3F0AC152842F908F.title: "Пруденциум: материалы"
	quest.3F0AC152842F908F.quest_subtitle: "Слитки и самоцветы"
	quest.3F0AC152842F908F.quest_desc: ["&6Как работает:&r слиток и самоцвет — основные материалы ступени, из них делают инструменты, броню и блоки.", "&6Зачем нужен:&r без них не создать ни одну вещь этой ступени.", "&6Как использовать:&r получаются на алтаре инфузии из материалов предыдущей ступени и эссенции."]
	quest.0D9E18D8C717E35C.title: "Пруденциум: грядки"
	quest.0D9E18D8C717E35C.quest_subtitle: "Земля и ускорители роста"
	quest.0D9E18D8C717E35C.quest_desc: ["&6Как работает:&r особая земля ускоряет рост семян, а ускоритель сокращает время созревания рядом стоящих культур.", "&6Зачем нужен:&r чем выше ступень, тем быстрее и выгоднее урожай.", "&6Как использовать:&r посадите семена на землю нужной ступени и поставьте ускоритель рядом."]
	quest.276D1580116F1B43.title: "Пруденциум: улучшения"
	quest.276D1580116F1B43.quest_subtitle: "Улучшение для машин"
	quest.276D1580116F1B43.quest_desc: ["&6Как работает:&r улучшение вставляется в машины Mystical Agriculture и повышает их скорость.", "&6Зачем нужен:&r ускоряет автоматизацию.", "&6Как использовать:&r поместите в слот улучшений на машине."]
	quest.717946F13AFF9B6E.title: "Пруденциум: лейка"
	quest.717946F13AFF9B6E.quest_subtitle: "Лейка нужной ступени"
	quest.717946F13AFF9B6E.quest_desc: ["&6Как работает:&r лейка поливает область вокруг и ускоряет рост культур.", "&6Зачем нужен:&r полезна пока автоматизации ещё нет.", "&6Как использовать:&r зажмите ПКМ рядом с грядками."]
	quest.6BF5F0365747388B.title: "Пруденциум: жатва"
	quest.6BF5F0365747388B.quest_subtitle: "Серп и коса"
	quest.6BF5F0365747388B.quest_desc: ["&6Как работает:&r серп собирает урожай по области, коса — по ещё большей.", "&6Зачем нужен:&r быстрый ручной сбор.", "&6Как использовать:&r ЛКМ по зрелой культуре."]
	quest.613648D49E643216.title: "Пруденциум: инструменты"
	quest.613648D49E643216.quest_subtitle: "Меч, кирка, топор, лопата, мотыга"
	quest.613648D49E643216.quest_desc: ["&6Как работает:&r полный набор инструментов ступени.", "&6Зачем нужен:&r прочнее и эффективнее предыдущих.", "&6Как использовать:&r собираются из слитков ступени на верстаке."]
	quest.3307658DB8F9C8DA.title: "Пруденциум: снаряжение"
	quest.3307658DB8F9C8DA.quest_subtitle: "Лук, арбалет, удочка, ножницы"
	quest.3307658DB8F9C8DA.quest_desc: ["&6Как работает:&r дальнобойное и вспомогательное снаряжение ступени.", "&6Зачем нужен:&r закрывает все виды деятельности.", "&6Как использовать:&r как обычные аналоги."]
	quest.20D5F2C59C5E6F55.title: "Пруденциум: броня"
	quest.20D5F2C59C5E6F55.quest_subtitle: "Полный комплект"
	quest.20D5F2C59C5E6F55.quest_desc: ["&6Как работает:&r четыре части брони дают защиту выше предыдущей ступени.", "&6Зачем нужен:&r полный комплект — надёжная защита.", "&6Как использовать:&r соберите все четыре части."]
	quest.3B0D203A39E34210.title: "Пруденциум: посох"
	quest.3B0D203A39E34210.quest_subtitle: "Посох ступени"
	quest.3B0D203A39E34210.quest_desc: ["&6Как работает:&r магический посох ступени.", "&6Зачем нужен:&r особое оружие/инструмент мода.", "&6Как использовать:&r ПКМ в нужном режиме."]
